# Upsilon Stack Environment Template
# This file serves as a blueprint for the .env file used in production.
# Post-cutover (Phase 6 §E) the stack is hub + auth + economy + proxy + engine
# + db: the Laravel/Reverb variables are gone. Phase 4/5 extracted auth and
# economy into their own services, reached over an internal S2S seam.

# Hub (serves API + SSE + SPA on :8090 behind the Caddy front door)
DATABASE_URL=postgres://postgres:postgres@db:5432/upsilon?sslmode=disable
APP_DEBUG=false
# Admin seed block is skipped with a warning when unset (hub -seed, auth -seed).
ADMIN_INITIAL_PASSWORD=GENERATED_SECRET

# Phase-4/5 extraction: hub <-> auth/economy internal S2S surface.
# S2S_TOKEN is shared by hub, auth and economy to authenticate service-to-
# service calls (introspection, wallet reads, AccountPush jobs). Mandatory —
# the hub crashes at boot (config.RequireServe) if any of these are unset.
ECONOMY_INTERNAL_URL=http://economy:8092
AUTH_INTERNAL_URL=http://auth:8091
S2S_TOKEN=GENERATED_SECRET

# Go Engine (Internal network)
UPSILON_API_URL=http://engine:8081
# Engine callbacks land on the hub through the front door.
UPSILON_WEBHOOK_URL=http://proxy:8085/api/webhook/upsilon

# CLI Configuration
UPSILON_BASE_URL=http://proxy:8085
