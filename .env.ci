# .env.ci — Deterministic CI Environment
# This file is committed to the repository and used by GitHub Actions.
# All credentials are dummy values for ephemeral testing.
# Post-cutover (Phase 6 §E) the stack is hub + proxy + engine + db.

# Hub (compose sets DATABASE_URL/APP_DEBUG per service; the seed init
# container reads the admin gate from here)
ADMIN_INITIAL_PASSWORD=AdminPassword123!

# Go Engine (internal Docker network)
UPSILON_API_URL=http://engine:8081
UPSILON_WEBHOOK_URL=http://proxy:8085/api/webhook/upsilon

# CLI Configuration (host runs target the exposed front door)
UPSILON_BASE_URL=http://localhost:8085
